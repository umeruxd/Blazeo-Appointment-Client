{
  "name": "@blazeo.com/appointment-client",
  "version": "1.0.52",
  "publishConfig": {
    "access": "public"
  },
  "author": "Blazeo",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ACCESS_TOKEN.md",
    "CUSTOM_FIELDS_FLOW.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "verify:locations": "npm run build && node scripts/verifyCalendarLocationReplace.mjs",
    "verify:appointment-location": "npm run build && node scripts/verifyAppointmentCalendarLocation.mjs",
    "verify:field-requirements": "npm run build && node scripts/verifyFieldRequirements.mjs",
    "verify:lead-field-http": "npm run build && node scripts/verifyLeadFieldRequirementsHttp.mjs",
    "verify:reminder-recipients": "npm run build && node scripts/verifyReminderRecipients.mjs",
    "verify:access-token": "npm run build && node scripts/verifyAccessToken.mjs",
    "verify:crm-lead-fields": "npm run build && node scripts/verifyCrmCalendarLeadFields.mjs",
    "verify:crm-lead-fields-fetch": "npm run build && node scripts/verifyCrmCalendarLeadFieldsFetch.mjs"
  },
  "dependencies": {
    "@blazeo.com/calendar-client": "^1.0.88",
    "mobx": "^6.13.7",
    "mobx-state-tree": "^7.0.2",
    "moment": "^2.30.1"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
